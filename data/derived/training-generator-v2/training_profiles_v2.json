  {
    "id": "flat_retroflex_contrast",
    "name": "平翘舌对比（含 r）",
    "dimension": "initial",
    "mode": "contrast",
    "target_sets": {
      "A": ["z", "c", "s"],
      "B": ["zh", "ch", "sh", "r"]
    },
    "allow_other": false,
    "buckets": [
      {
        "id": "cross",
        "label": "跨组 A↔B",
        "target_ratio": 0.6,
        "role": "cross",
        "rule": {
          "op": "all",
          "rules": [
            {"op": "all_in", "sets": ["A", "B"]},
            {"op": "groups_present", "sets": ["A", "B"], "min": 2}
          ]
        },
        "pair_specs": [
          {"left": "A", "right": "B"},
          {"left": "B", "right": "A"}
        ]
      },
      {
        "id": "same",
        "label": "同组 A+A / B+B",
        "target_ratio": 0.4,
        "role": "same",
        "rule": {
          "op": "all",
          "rules": [
            {"op": "all_in", "sets": ["A", "B"]},
            {
              "op": "not",
              "rule": {"op": "groups_present", "sets": ["A", "B"], "min": 2}
            }
          ]
        },
        "pair_specs": [
          {"left": "A", "right": "A"},
          {"left": "B", "right": "B"}
        ]
      }
    ],
    "scarcity": {"repeat_allowed": true, "max_repeat": 2, "min_gap": 20},
    "notes": "100% 在 A/B 体系内部，O=0；单字归同组。"
  },
