[
  {
    "id": "bilabial_focus",
    "name": "双唇音单项",
    "dimension": "initial",
    "mode": "single_focus",
    "target_sets": {"T": ["b", "p", "m"]},
    "buckets": [
      {
        "id": "core",
        "label": "核心 T×T",
        "target_ratio": 0.8,
        "role": "core",
        "rule": {"op": "all_in", "sets": ["T"]},
        "pair_specs": [{"left": "T", "right": "T"}]
      },
      {
        "id": "supplement",
        "label": "补充 T↔O",
        "target_ratio": 0.2,
        "role": "supplement",
        "rule": {
          "op": "all",
          "rules": [
            {"op": "any_in", "sets": ["T"]},
            {"op": "not", "rule": {"op": "all_in", "sets": ["T"]}}
          ]
        },
        "pair_specs": [
          {"left": "T", "right": "O"},
          {"left": "O", "right": "T"}
        ]
      }
    ],
    "allow_other": true,
    "scarcity": {"repeat_allowed": true, "max_repeat": 2, "min_gap": 20},
    "notes": "单字 b/p/m 属核心单点。"
  },
