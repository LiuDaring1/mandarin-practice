 .cal-groups { gap: 17px; padding-bottom: 28px; }
 .cal-group { padding: 16px 13px 13px; border: 1px solid #eee0ca; border-radius: 25px; background: #fffdfa; box-shadow: var(--shadow-card); }
 .cal-group-label { margin: 0 0 11px; text-align: center; font-size: 19px; font-weight: 650; color: #5e4936; }
-.cal-pair { gap: 9px; }
+.cal-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.cal-speed { display: flex; flex: 1; gap: 4px; padding: 4px; border-radius: 17px; background: var(--violet-soft); }
+.cal-speed button { flex: 1; min-height: 44px; padding: 8px; border: 0; border-radius: 13px; background: transparent; color: var(--violet-deep); font-size: 12px; white-space: nowrap; }
+.cal-speed button[aria-pressed="true"] { background: #fffefa; box-shadow: var(--shadow-soft); color: var(--teal-deep); }
+#cal-stop { width: auto; flex: 0 0 auto; min-width: 56px; min-height: 44px; padding: 8px; }
+.cal-status { min-height: 40px; margin: 9px 2px 0; font-size: 12px; color: var(--muted); line-height: 1.6; }
+.cal-pair { gap: 9px; flex-direction: column; }
+.cal-card { min-width: 0; padding: 0; }
+.cal-card .cal-video { aspect-ratio: 16 / 9; background: #fffaf0; }
+.cal-video video { object-fit: contain; }
+.cal-card.playing::after { pointer-events: none; }
 .cal-card { overflow: hidden; border: 1.5px solid color-mix(in srgb, var(--card-tone) 30%, #fff); border-radius: 17px; box-shadow: none; background: #f6ede0; }
 .cal-card .cal-video { border-radius: 14px; }
 .cal-card.playing { box-shadow: 0 0 0 3px color-mix(in srgb, var(--card-tone) 15%, transparent); }
